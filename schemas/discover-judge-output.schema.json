{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paulohenriquevn/judge-codex-plugin-cc/schemas/discover-judge-output.schema.json",
  "title": "judge-codex discover stage output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "score",
    "hard_caps_triggered",
    "soft_caps_triggered",
    "findings",
    "summary",
    "claude_side_verdict_anchor",
    "model_used",
    "elapsed_ms"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "SHIPPABLE",
        "SHIPPABLE_WITH_CAVEATS",
        "NEEDS_REVISION",
        "FAIL_SOFT",
        "FAIL_HARD",
        "INVALID"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "hard_caps_triggered": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "single_source_evidence",
          "fabricated_citation",
          "empty_research_question",
          "empty_coverage_corner"
        ]
      }
    },
    "soft_caps_triggered": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "soft_cap_acceptable_disagreement_silent",
          "soft_cap_cross_cutting_axis_single_source",
          "soft_cap_empty_corner_unflagged"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "stable_id",
          "title",
          "body",
          "blueprint_section",
          "recommendation",
          "confidence"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "stable_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "blueprint_section": {
            "type": "string"
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "claude_side_verdict_anchor": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "disagreement": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "verdict",
        "score",
        "disagreement"
      ]
    },
    "model_used": {
      "type": [
        "string",
        "null"
      ],
      "default": "gpt-5-codex"
    },
    "elapsed_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
