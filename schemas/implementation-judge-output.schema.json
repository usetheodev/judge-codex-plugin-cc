{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paulohenriquevn/judge-codex-plugin-cc/schemas/implementation-judge-output.schema.json",
  "title": "judge-codex implementation stage output",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "score", "hard_caps_triggered", "soft_caps_triggered", "findings", "wiring_triad_table", "plan_vs_commits", "summary"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["SHIPPABLE", "SHIPPABLE_WITH_CAVEATS", "NEEDS_REVISION", "FAIL_SOFT", "FAIL_HARD", "INVALID"]
    },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "hard_caps_triggered": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "wiring_triad_pillar_a_missing",
          "tdd_red_before_green_missing",
          "symbol_fabrication_production",
          "changelog_unreleased_empty"
        ]
      }
    },
    "soft_caps_triggered": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "soft_cap_dead_code_introduced",
          "soft_cap_plan_commits_divergence",
          "soft_cap_test_pyramid_imbalanced",
          "soft_cap_refactor_in_green_commit",
          "soft_cap_plan_amended_without_reattest"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "stable_id", "title", "body", "file", "recommendation"],
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "stable_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "file": { "type": "string" },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "commit_sha": { "type": "string" },
          "recommendation": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "wiring_triad_table": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "pillar_a", "pillar_b", "pillar_c"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "pillar_a": { "type": "string", "enum": ["pass", "fail"] },
          "pillar_b": { "type": "string", "enum": ["pass", "defer", "fail"] },
          "pillar_c": { "type": "string", "enum": ["pass", "n/a", "defer", "fail"] },
          "deferral_adr": { "type": "string" }
        }
      }
    },
    "plan_vs_commits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_tasks_total", "tasks_with_commits", "orphan_commits"],
      "properties": {
        "plan_tasks_total": { "type": "integer", "minimum": 0 },
        "tasks_with_commits": { "type": "integer", "minimum": 0 },
        "orphan_commits": { "type": "array", "items": { "type": "string" } },
        "drift_events_logged": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "claude_side_verdict_anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": { "type": "string" },
        "code_quality_verdict": { "type": "string" },
        "disagreement": { "type": "boolean" }
      }
    },
    "model_used": { "type": "string", "default": "gpt-5-codex" },
    "elapsed_ms": { "type": "integer", "minimum": 0 }
  }
}
